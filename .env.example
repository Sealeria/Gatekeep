# Gatekeep — Docker install
#   cp .env.example .env && docker compose up -d --build
GATEKEEP_HOST=0.0.0.0
GATEKEEP_PORT=9477
GATEKEEP_AGENT_HOST=0.0.0.0
GATEKEEP_AGENT_PORT=9478

# Public URLs clients use (required when binding 0.0.0.0 on a remote host)
# GATEKEEP_PUBLIC_URL=http://your-server:9477
# GATEKEEP_AGENT_URL=http://your-server:9478

# Optional proxy auth (unset = open; use Tailscale/VPN or set a key)
# GATEKEEP_API_KEY=

# Verbose proxy logging (debug level)
# GATEKEEP_DEBUG=0

# Upstream overrides (optional)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com

# Local dev convenience (legacy)
HOST=127.0.0.1
PORT=9477
